<Project Sdk="Microsoft.Build.Traversal">

  <PropertyGroup>
    <TargetFramework>$(NetCoreAppCurrent)-$(TargetOS)</TargetFramework>
    <!-- OpenHarmony compiles in the linux group (no -openharmony TFM exists);
         see src/libraries/Directory.Build.props (LibrariesOpenHarmonySfxTfm). -->
    <TargetFramework Condition="'$(TargetsOpenHarmony)' == 'true'">$(LibrariesOpenHarmonySfxTfm)</TargetFramework>
    <NoDefaultSlnGenSolutionFolder>true</NoDefaultSlnGenSolutionFolder>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="sfx-src.proj" />
    <ProjectReference Include="sfx-gen.proj" />
    <ProjectReference Include="sfx-finish.proj" />
  </ItemGroup>

</Project>
