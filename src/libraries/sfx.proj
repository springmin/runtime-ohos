<Project Sdk="Microsoft.Build.Traversal">

  <PropertyGroup>
    <TargetFramework>$(NetCoreAppCurrent)-$(TargetOS)</TargetFramework>
    <!-- OHOS keeps its own TargetOS (RID-independence review) but the managed
         libs must compile in the unix group (dotnet has no -ohos TFM; linux
         family compiles net11.0-unix). Compile-level mapping the review keeps
         for configureplatform.cmake — the MSBuild-layer equivalent (PR-R3). -->
    <!-- OHOS compiles in the linux group (TargetsLinux incl. ohos; dotnet has
         no -ohos TFM). unix-group-only libs (Console, ...) resolve via the
         unix flavor; -linux/-osx libs (Process, FileSystemWatcher, ...) pick
         their exact flavor — same as a linux build (26451.1 os=linux). -->
    <TargetFramework Condition="'$(TargetsOpenHarmony)' == 'true'">$(NetCoreAppCurrent)-linux</TargetFramework>
    <NoDefaultSlnGenSolutionFolder>true</NoDefaultSlnGenSolutionFolder>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="sfx-src.proj" />
    <ProjectReference Include="sfx-gen.proj" />
    <ProjectReference Include="sfx-finish.proj" />
  </ItemGroup>

</Project>
